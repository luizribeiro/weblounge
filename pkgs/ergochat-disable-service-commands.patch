diff --git a/irc/services_test.go b/irc/services_test.go
new file mode 100644
index 0000000..37991f1
--- /dev/null
+++ b/irc/services_test.go
@@ -0,0 +1,60 @@
+// Copyright (c) 2026 Luiz Ribeiro
+// released under the MIT license
+
+package irc
+
+import (
+	"testing"
+)
+
+func TestDisabledServiceCommands(t *testing.T) {
+	disabled, err := resolveDisabledServiceCommands(map[string][]string{
+		"NickServ": {"UNREGISTER", "passwd"},
+		"hostserv": {"on", "off"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var config Config
+	config.Accounts.AuthenticationEnabled = true
+	config.Accounts.Registration.Enabled = true
+	config.Accounts.VHosts.Enabled = true
+	config.Channels.Registration.Enabled = true
+	withDisabled := config
+	withDisabled.Accounts.disabledServiceCommands = disabled
+
+	for _, tc := range []struct {
+		service *ircService
+		command string
+		enabled bool
+	}{
+		{nickservService, "unregister", false},
+		{nickservService, "passwd", false},
+		{nickservService, "password", false},
+		{nickservService, "cert", true},
+		{hostservService, "on", false},
+		{hostservService, "off", false},
+		{hostservService, "status", true},
+		{chanservService, "register", true},
+	} {
+		cmd := lookupServiceCommand(tc.service.Commands, tc.command)
+		if !cmd.isEnabled(&config) {
+			t.Errorf("%s %s: expected enabled without disabled-service-commands", tc.service.Name, tc.command)
+		}
+		if cmd.isEnabled(&withDisabled) != tc.enabled {
+			t.Errorf("%s %s: expected enabled=%t", tc.service.Name, tc.command, tc.enabled)
+		}
+	}
+}
+
+func TestDisabledServiceCommandsInvalid(t *testing.T) {
+	for _, disabled := range []map[string][]string{
+		{"memoserv": {"send"}},
+		{"nickserv": {"unregsiter"}},
+		{"hostserv": {"help"}},
+	} {
+		if _, err := resolveDisabledServiceCommands(disabled); err == nil {
+			t.Errorf("%v: expected an error", disabled)
+		}
+	}
+}
