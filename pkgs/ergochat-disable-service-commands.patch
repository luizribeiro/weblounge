diff --git a/irc/services.go b/irc/services.go
index 8e243f4..90f8cc5 100644
--- a/irc/services.go
+++ b/irc/services.go
@@ -46,6 +46,36 @@ type serviceCommand struct {
 	unsplitFinalParam bool // split into at most maxParams, with last param containing unsplit text
 }
 
+// is this command enabled, both by its own condition and by
+// accounts.disabled-service-commands?
+func (cmd *serviceCommand) isEnabled(config *Config) bool {
+	return (cmd.enabled == nil || cmd.enabled(config)) && !config.Accounts.disabledServiceCommands[cmd]
+}
+
+// resolves accounts.disabled-service-commands to the commands it names,
+// so that disabling a command also disables its aliases
+func resolveDisabledServiceCommands(disabled map[string][]string) (map[*serviceCommand]bool, error) {
+	result := make(map[*serviceCommand]bool)
+	for serviceName, commandNames := range disabled {
+		service, ok := ErgoServices[strings.ToLower(serviceName)]
+		if !ok {
+			return nil, fmt.Errorf("disabled-service-commands: unknown service %s", serviceName)
+		}
+		for _, commandName := range commandNames {
+			commandName = strings.ToLower(commandName)
+			if commandName == "help" {
+				return nil, fmt.Errorf("disabled-service-commands: %s HELP can't be disabled", service.Name)
+			}
+			cmd := lookupServiceCommand(service.Commands, commandName)
+			if cmd == nil {
+				return nil, fmt.Errorf("disabled-service-commands: unknown command %s %s", service.Name, commandName)
+			}
+			result[cmd] = true
+		}
+	}
+	return result, nil
+}
