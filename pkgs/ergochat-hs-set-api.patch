+type apiHsSetRequest struct {
+	AccountName string `json:"accountName"`
+	VHost       string `json:"vhost"`
+}
+
+func (a *ergoAPI) handleHsSet(w http.ResponseWriter, r *http.Request) {
+	var request apiHsSetRequest
+	if err := a.decodeJSONRequest(&request, w, r); err != nil {
+		return
+	}
+
+	var response apiGenericResponse
+	if !hostservEnabled(a.server.Config()) {
+		response.ErrorCode = "FEATURE_DISABLED"
+		a.writeJSONResponse(response, w, r)
+		return
+	}
+	if request.AccountName == "" {
+		response.ErrorCode = "INVALID_REQUEST"
+		a.writeJSONResponse(response, w, r)
+		return
+	}
+	if request.VHost != "" && validateVhost(a.server, request.VHost, true) != nil {
+		response.ErrorCode = "INVALID_VHOST"
+		a.writeJSONResponse(response, w, r)
+		return
+	}
+
+	_, err := a.server.accounts.VHostSet(request.AccountName, request.VHost)
+	switch err {
+	case nil:
+		response.Success = true
+		var message string
+		if request.VHost != "" {
+			message = fmt.Sprintf("API set vhost %[1]s on account %[2]s", request.VHost, request.AccountName)
+		} else {
+			message = fmt.Sprintf("API cleared vhost on account %s", request.AccountName)
+		}
+		a.server.snomasks.Send(sno.LocalVhosts, message)
+	case errAccountDoesNotExist:
+		response.ErrorCode = "ACCOUNT_DOES_NOT_EXIST"
+	case errAccountUnverified:
+		response.ErrorCode = "ACCOUNT_UNVERIFIED"
+	case errFeatureDisabled:
+		response.ErrorCode = "FEATURE_DISABLED"
+	default:
+		a.server.logger.Error("api", "could not change vhost:", err.Error())
+		response.ErrorCode = "UNKNOWN_ERROR"
+		response.Error = err.Error()
+	}
+
+	a.writeJSONResponse(response, w, r)
+}
+
