+
+type apiNsEraseRequest struct {
+	AccountName string `json:"accountName"`
+}
+
+func (a *ergoAPI) handleNsErase(w http.ResponseWriter, r *http.Request) {
+	var request apiNsEraseRequest
+	if err := a.decodeJSONRequest(&request, w, r); err != nil {
+		return
+	}
+
+	var response apiGenericResponse
+	if request.AccountName == "" {
+		response.ErrorCode = "INVALID_REQUEST"
+		a.writeJSONResponse(response, w, r)
+		return
+	}
+	accountName := a.server.accounts.AccountToAccountName(request.AccountName)
+	if accountName == "" {
+		response.ErrorCode = "ACCOUNT_DOES_NOT_EXIST"
+		a.writeJSONResponse(response, w, r)
+		return
+	}
+
+	err := a.server.accounts.Unregister(accountName, true)
+	switch err {
+	case nil:
+		response.Success = true
+		a.server.logger.Info("api", "erased account", accountName)
+		a.server.snomasks.Send(sno.LocalAccounts, fmt.Sprintf("API erased account %s", accountName))
+	case errAccountDoesNotExist:
+		response.ErrorCode = "ACCOUNT_DOES_NOT_EXIST"
+	default:
+		a.server.logger.Error("api", "could not erase account:", err.Error())
+		response.ErrorCode = "UNKNOWN_ERROR"
+		response.Error = err.Error()
+	}
+
+	a.writeJSONResponse(response, w, r)
 }
 
