+
+func TestBuildPushMessageTruncation(t *testing.T) {
+	now, err := time.Parse(utils.IRCv3TimestampFormat, "2025-01-12T01:05:04.422Z")
+	if err != nil {
+		panic(err)
+	}
+
+	// mix 1-, 2- and 4-byte codepoints so that the cut can land inside one
+	for _, message := range []string{
+		strings.Repeat("a", 1000),
+		strings.Repeat("é", 500),
+		"a" + strings.Repeat("😀", 250),
+		"ab" + strings.Repeat("😀", 250),
+	} {
+		lineBytes, err := MakePushMessage("PRIVMSG", "shivaram!~u@kca7nfgniet7q.irc", "shivaram", "slingamn", utils.SplitMessage{
+			Message: message,
+			Msgid:   "t8st5bb4b9qhed3zs3pwspinca",
+			Time:    now,
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		line := string(lineBytes)
+		parsed, err := ircmsg.ParseLineStrict(line, false, 512)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if ok, msgid := parsed.GetTag("msgid"); !ok || msgid != "t8st5bb4b9qhed3zs3pwspinca" {
+			t.Fatalf("bad msgid tag %s", msgid)
+		}
+		if parsed.Source != "shivaram!~u@kca7nfgniet7q.irc" || parsed.Command != "PRIVMSG" || len(parsed.Params) != 2 || parsed.Params[0] != "slingamn" {
+			t.Fatalf("bad line: %s", line)
+		}
+		body := line[strings.IndexByte(line, ' ')+1:]
+		if len(body) > 510 || len(body) < 510-(utf8.UTFMax-1) {
+			t.Fatalf("push line body is %d bytes", len(body))
+		}
+		if truncated := parsed.Params[1]; !utf8.ValidString(truncated) || !strings.HasPrefix(message, truncated) {
+			t.Fatalf("bad truncation of message: %q", truncated)
+		}
+	}
+}
