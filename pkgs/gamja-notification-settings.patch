diff --git a/lib/notification.js b/lib/notification.js
--- /dev/null
+++ b/lib/notification.js
@@ -0,0 +1,33 @@
+// Workaround for https://bugs.chromium.org/p/chromium/issues/detail?id=481856
+function checkSupported() {
+	if (!window.Notification) {
+		return false;
+	}
+	if (Notification.permission === "default") {
+		try {
+			new Notification("");
+		} catch (err) {
+			if (err.name === "TypeError") {
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+export const supported = checkSupported();
+
+export function show(settings, title, options) {
+	if (!supported || !settings.desktopNotifications || Notification.permission !== "granted") {
+		return null;
+	}
+
+	// This can still fail due to:
+	// https://bugs.chromium.org/p/chromium/issues/detail?id=481856
+	try {
+		return new Notification(title, options);
+	} catch (err) {
+		console.error("Failed to show notification: ", err);
+		return null;
+	}
+}
