#!/usr/bin/env bash
# Usage: scripts/check-units <ssh-host>
# Waits for the jobs a switch left running, such as certificate orders,
# then fails if any unit failed or is waiting to retry after failing.
# Extra ssh options go in NIX_SSHOPTS, as for scripts/push.
set -euo pipefail

host=$1
timeout=${CHECK_UNITS_TIMEOUT:-300}

# NIX_SSHOPTS is a list of words.
# shellcheck disable=SC2029,SC2086
ssh ${NIX_SSHOPTS:-} "$host" "timeout=$timeout; $(cat <<'EOF'
for _ in $(seq "$timeout"); do
  [ -z "$(systemctl list-jobs --no-legend)" ] && break
  sleep 1
done
pending=$(systemctl list-jobs --no-legend --plain)
broken=$(systemctl list-units --no-legend --plain --state=failed,auto-restart)
[ -z "$pending$broken" ] && exit 0
[ -n "$pending" ] && printf 'still running after %ss:\n%s\n' "$timeout" "$pending" >&2
[ -n "$broken" ] && printf 'failed, or waiting to retry:\n%s\n' "$broken" >&2
exit 1
EOF
)"
