#!/usr/bin/env bash
# Usage: scripts/wait-for-dns <host's config flake attr>
# Waits until every nameserver of the host's domain answers each name it
# orders a certificate for with the host's address, so the CA finds the
# name wherever it looks. A name that never resolves fails the wait.
set -euo pipefail

config=$1
timeout=${WAIT_FOR_DNS_TIMEOUT:-600}

domain=$(nix eval --raw "$config.weblounge.domain")
address=$(nix eval --raw "$config.weblounge.publicIPv4")
mapfile -t names < <(nix eval --raw "$config.security.acme.certs" --apply \
  'certs: builtins.concatStringsSep "\n" (builtins.concatLists (builtins.attrValues
     (builtins.mapAttrs (name: cert: [ name ] ++ cert.extraDomainNames) certs)))')
mapfile -t nameservers < <(dig +short NS "$domain")
if [ ${#nameservers[@]} -eq 0 ]; then
  echo "found no nameservers for $domain" >&2
  exit 1
fi

deadline=$((SECONDS + timeout))
for nameserver in "${nameservers[@]}"; do
  for name in "${names[@]}"; do
    until [ "$(dig +short "$name" A "@$nameserver" | tail -n 1)" = "$address" ]; do
      if [ "$SECONDS" -ge "$deadline" ]; then
        echo "$nameserver doesn't answer $name with $address after ${timeout}s" >&2
        exit 1
      fi
      sleep 10
    done
  done
done
